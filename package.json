{
  "name": "orgo-mcp-server",
  "version": "1.1.1",
  "description": "MCP server for Orgo cloud computers, generated from the live Orgo OpenAPI spec",
  "license": "MIT",
  "author": "Orgo",
  "homepage": "https://docs.orgo.ai/guides/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickvasilescu/orgo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nickvasilescu/orgo-mcp/issues"
  },
  "type": "module",
  "main": "build/server.js",
  "types": "build/server.d.ts",
  "exports": {
    ".": {
      "types": "./build/server.d.ts",
      "import": "./build/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "orgo-mcp-server": "build/index.js"
  },
  "files": [
    "build",
    "openapi.snapshot.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "sync": "tsx scripts/sync.ts",
    "test": "tsc -p tsconfig.check.json && tsx test/tools.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "orgo",
    "computer-use"
  ]
}
